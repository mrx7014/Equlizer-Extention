{
  "manifest_version": 3,
  "name": "Equalizer Extension",
  "version": "1.0.0",
  "description": "Add echo, reverb, bass boost, and audio controls to YouTube videos.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Equalizer Extension",
    "default_icon": {
      "16": "assets/logo.png",
      "48": "assets/logo.png",
      "128": "assets/logo.png"
    }
  },
  "icons": {
    "16": "assets/logo.png",
    "48": "assets/logo.png",
    "128": "assets/logo.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
